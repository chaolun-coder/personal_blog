<style>
  .animate-breathing {
    animation: breathing 2s ease-in-out infinite;
  }

  @keyframes breathing {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }
</style>